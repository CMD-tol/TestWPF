"_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="66"/><column index="2" value="69"/><column index="3" value="71"/><column index="4" value="79"/><column index="5" value="57"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Shopper" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="68"/><column index="2" value="87"/><column index="3" value="54"/><column index="4" value="43"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="test" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="106"/><column index="2" value="94"/><column index="3" value="41"/><column index="4" value="41"/><column index="5" value="41"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- =============================================
-- 1. Товары (только о товаре)
-- =============================================
CREATE TABLE Product (
    IDProduct INTEGER PRIMARY KEY AUTOINCREMENT,
    NameProduct TEXT NOT NULL,
    Articul TEXT UNIQUE,
    Description TEXT,
    BasePrice REAL NOT NULL
);

-- =============================================
-- 2. Продавцы (только о продавце)
-- =============================================
CREATE TABLE Shopper (
    IDShopper INTEGER PRIMARY KEY AUTOINCREMENT,
    NameShopper TEXT NOT NULL,
    Address TEXT,
    Phone TEXT
);

-- =============================================
-- 3. Скидки (вынесено отдельно, чтобы не дублировать)
-- =============================================
CREATE TABLE Discount (
    IDDiscount INTEGER PRIMARY KEY AUTOINCREMENT,
    DiscountPercent INTEGER NOT NULL,
    StartDate TEXT,
    EndDate TEXT
);

-- =============================================
-- 4. Цены и наличие (связь товара с продавцом)
-- =============================================
CREATE TABLE ProductShopper (
    IDProduct INTEGER,
    IDShopper INTEGER,
    IDDiscount INTEGER,
    CurrentPrice REAL NOT NULL,
    Quantity INTEGER DEFAULT 0,
    PRIMARY KEY (IDProduct, IDShopper),
    FOREIGN KEY (IDProduct) REFERENCES Product(IDProduct),
    FOREIGN KEY (IDShopper) REFERENCES Shopper(IDShopper),
    FOREIGN KEY (IDDiscount) REFERENCES Discount(IDDiscount)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
